//@address = http://2.31.152.184:3000
@address = http://localhost:3000

### Get HelloWorld
GET {{address}}

### Get set
GET {{address}}/set/SOM
Accept: application/json;

### Get set
GET {{address}}/set/RNA
Accept: application/json;

### Get set
GET {{address}}/set/XXX
Accept: application/json;

### Get sets
GET {{address}}/set
Accept: application/json;

### Post custom set
POST {{address}}/set/mse
Accept: application/json;
Content-Type: application/zip

< ./MSPaint Adventures.mse-set

### Post custom set
POST {{address}}/set/mse/cards/msp
Accept: application/json;
Content-Type: text/xml

< ./mspa.xml

### Import cards from official set
POST {{address}}/set/to/RNA/cards
Accept: application/json;

### Get card
GET {{address}}/card/set/SOM/102
Accept: application/json;

### Get card
GET {{address}}/card/set/RNA/3
Accept: application/json;

### Get card
GET {{address}}/card/to/1x Woodland Mystic
Accept: application/json;

### Get card
GET {{address}}/card/csv/main,1,"Maralen, Fae Ascendant",ECL,,,,,,True
Accept: application/json;

### Get card
GET {{address}}/card/csv/main,1,Leaf-Crowned Visionary,DMU,,,,,,
Accept: application/json;

### Get cards in storage
GET {{address}}/card/set/one
Accept: application/json;

### Update image of card
POST {{address}}/card/set/SOM/102/image
Accept: image/png;
Content-Type: image/png

< ./jerso.png

### Get image of card
GET {{address}}/card/set/afr/46/image
Accept: image/png;

### Import cards
POST {{address}}/cards/import/csv
Accept: application/json;
Content-Type: text/csv;

< ./elves.csv

### Import deck csv
POST {{address}}/deck/import/csv/Elves In A Hot Tub
Accept: application/json;
Content-Type: text/csv;

< ./elves.csv

### Import deck csv
POST {{address}}/deck/import/csv/Prolif3rate
Accept: application/json;
Content-Type: text/csv;

< ./prolif3rate.csv

### Get deck
GET {{address}}/deck/id/Prolif3rate
Accept: application/json;
Content-Type: text/csv;

### Get nonexistant deck
GET {{address}}/deck/id/splurge
Accept: application/json;
Content-Type: text/csv;

### List decks
GET {{address}}/deck
Accept: application/json;
Content-Type: text/csv;